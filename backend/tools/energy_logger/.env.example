# --- where readings go -------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service key>
# Must match the browser's id so the app and the logger share a household.
# Get it in the app's console: localStorage.getItem('kroven_household_id')
KROVEN_HOUSEHOLD_ID=

# --- Kasa KP125M (active now) ------------------------------------------
KASA_HOST=10.0.0.163
KASA_DEVICE_NAME=PS5
# Newer Kasa firmware needs TP-Link account credentials even on the LAN.
KASA_USERNAME=
KASA_PASSWORD=

# --- Shelly (dormant until this is filled in) --------------------------
SHELLY_HOST=
SHELLY_DEVICE_NAME=shelly
SHELLY_CHANNEL=0

# --- tuning ------------------------------------------------------------
POLL_SECONDS=60
